# ─── Emulador Firebase (DESARROLLO LOCAL) ──────────────────────────────────
# Crea un archivo .env.local (en la raíz del proyecto) con esta línea para
# activar los emuladores locales de Firestore y Functions:
#
#   VITE_USE_EMULATORS=true
#
# Si NO la pones (o la pones en false), el frontend hablará directo con
# Firebase de PRODUCCIÓN. Útil para emitir facturas reales desde tu PC.
#
# IMPORTANTE: cuando uses emuladores, levanta primero:
#   firebase emulators:start --only functions,firestore
# y luego:   npm run dev

# ─── Firebase Configuration ────────────────────────────────────────────────
# (Tu config ya está hardcodeada en src/firebase/config.js — no necesitas
#  tocarla. Estos son ejemplos si quisieras externalizarla.)
VITE_FIREBASE_API_KEY=AIzaSyB6Z9zT1ba7Ab0sTSIdkoTaEABfW98Wxag
VITE_FIREBASE_AUTH_DOMAIN=noova-sac.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=noova-sac
VITE_FIREBASE_STORAGE_BUCKET=noova-sac.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=545069328523
VITE_FIREBASE_APP_ID=1:545069328523:web:7e05cf0d62af8c31b58c8e

# ─── Application settings ──────────────────────────────────────────────────
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173
