rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function userExists() {
      return isAuth()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function profile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isGerente() {
      return userExists()
        && profile().role in ['gerencia', 'gerente'];
    }

    function isAdministrador() {
      return userExists()
        && profile().role in ['administrador', 'admin'];
    }

    function isSoporteTI() {
      return userExists()
        && profile().role in ['soporte_ti', 'sistemas'];
    }

    function isMarketing() {
      return userExists()
        && profile().role in ['responsable_marketing', 'marketing'];
    }

    function isJefeProyectoMina() {
      return userExists()
        && profile().role in ['jefe_proyecto_mina', 'ing_minas'];
    }

    function isKnownRole() {
      return isGerente()
        || isAdministrador()
        || isSoporteTI()
        || isMarketing()
        || isJefeProyectoMina();
    }

    function isActiveUser() {
      return userExists()
        && isKnownRole()
        && (
          !('activo' in profile())
          || profile().activo == true
        );
    }

    function canBusinessAll() {
      return isActiveUser()
        && (isGerente() || isAdministrador());
    }

    function canManageUsers() {
      return isActiveUser()
        && (isGerente() || isSoporteTI());
    }

    function canUseMensajeria() {
      return isActiveUser()
        && (
          isGerente()
          || isAdministrador()
          || isSoporteTI()
          || isMarketing()
        );
    }

    function canReadClientesData() {
      return canBusinessAll()
        || (isActiveUser() && isMarketing())
        || canUseMensajeria();
    }

    function isJefeProyectoMinaActivo() {
      return isActiveUser() && isJefeProyectoMina();
    }

    function esSolicitud(data) {
      return data.tipoItem in ['solicitud', 'epp'];
    }

    function canReadSolicitudMinas() {
      return isJefeProyectoMinaActivo() && esSolicitud(resource.data);
    }

    function canCreateSolicitudMinas() {
      return isJefeProyectoMinaActivo() && request.resource.data.tipoItem == 'solicitud';
    }

    function canUpdateSolicitudMinas() {
      return isJefeProyectoMinaActivo()
        && esSolicitud(resource.data)
        && request.resource.data.tipoItem == 'solicitud';
    }

    function canGestionarPlantillas() {
      return isActiveUser() && (isGerente() || isAdministrador() || isSoporteTI());
    }

    function validOfficialRole(role) {
      return role in [
        'gerencia',
        'administrador',
        'soporte_ti',
        'responsable_marketing',
        'jefe_proyecto_mina'
      ];
    }

    function validOfficialArea(area) {
      return area in [
        'gerencia',
        'administracion',
        'marketing',
        'minas',
        'contabilidad',
        'sistemas'
      ];
    }

    function userRoleChangeIsValid() {
      return !(
        'role' in request.resource.data
          .diff(resource.data)
          .affectedKeys()
      )
      || (
        'role' in request.resource.data
        && validOfficialRole(request.resource.data.role)
      );
    }

    function userAreaChangeIsValid() {
      return !(
        'area' in request.resource.data
          .diff(resource.data)
          .affectedKeys()
      )
      || (
        'area' in request.resource.data
        && validOfficialArea(request.resource.data.area)
      );
    }

    function roleAreaCombinationIsValid(data) {
      return (
        data.role == 'gerencia' && data.area == 'gerencia'
      ) || (
        data.role == 'administrador' && data.area == 'administracion'
      ) || (
        data.role == 'soporte_ti' && data.area == 'sistemas'
      ) || (
        data.role == 'responsable_marketing' && data.area == 'marketing'
      ) || (
        data.role == 'jefe_proyecto_mina' && data.area == 'minas'
      );
    }

    function userRoleOrAreaChangeIsCoherent() {
      return !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny(['role', 'area'])
        || (
          ('role' in request.resource.data)
          && ('area' in request.resource.data)
          && validOfficialRole(request.resource.data.role)
          && validOfficialArea(request.resource.data.area)
          && roleAreaCombinationIsValid(request.resource.data)
        );
    }

    function permissionsChangeOnlyRemovesLegacyField() {
      return !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny(['permissions'])
        || !('permissions' in request.resource.data);
    }

    match /users/{userId} {
      allow get: if isAuth()
        && (
          request.auth.uid == userId
          || canManageUsers()
        );

      allow list: if canManageUsers();

      allow create: if canManageUsers()
        && request.auth.uid != userId
        && ('role' in request.resource.data)
        && ('area' in request.resource.data)
        && validOfficialRole(request.resource.data.role)
        && validOfficialArea(request.resource.data.area)
        && roleAreaCombinationIsValid(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'nombre',
          'cargo',
          'telefono',
          'email',
          'role',
          'area',
          'sector',
          'activo',
          'createdAt',
          'updatedAt'
        ]);

      allow update: if canManageUsers()
        && request.auth.uid != userId
        && userRoleChangeIsValid()
        && userAreaChangeIsValid()
        && userRoleOrAreaChangeIsCoherent()
        && permissionsChangeOnlyRemovesLegacyField()
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'nombre',
            'cargo',
            'telefono',
            'email',
            'role',
            'area',
            'sector',
            'permissions',
            'activo',
            'updatedAt'
          ]);

      allow update: if isActiveUser()
        && request.auth.uid == userId
        && (
          isGerente()
          || isAdministrador()
          || isSoporteTI()
          || isJefeProyectoMina()
        )
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'nombre',
            'cargo',
            'telefono',
            'email',
            'updatedAt'
          ]);

      allow delete: if canManageUsers()
        && request.auth.uid != userId;
    }

    match /clientes/{docId} {
      allow read: if canReadClientesData();

      allow create, update: if canBusinessAll();

      allow delete: if canBusinessAll();
    }

    match /cotizaciones/{docId} {
      allow read: if canBusinessAll() || canReadSolicitudMinas();
      allow create: if canBusinessAll() || canCreateSolicitudMinas();
      allow update: if canBusinessAll() || canUpdateSolicitudMinas();
      allow delete: if canBusinessAll();
    }

    match /equipos/{docId} {
      allow read, create, update, delete: if canBusinessAll();
    }

    match /mangas/{docId} {
      allow read, create, update, delete: if canBusinessAll();
    }

    match /servicios/{docId} {
      allow read, create, update, delete: if canBusinessAll();
    }

    match /plantillasSolicitud/{docId} {
      allow read: if canGestionarPlantillas() || isJefeProyectoMinaActivo();
      allow create, update, delete: if canGestionarPlantillas();
    }

    match /mensajeria/{docId} {
      allow read, create, update, delete: if canUseMensajeria();
    }

    match /proveedores/{docId} {
      allow read, create, update, delete: if canBusinessAll();
    }

    match /ordenesCompra/{docId} {
      allow read, create, update: if canBusinessAll();

      allow delete: if canBusinessAll()
        && (
          !('estado' in resource.data)
          || resource.data.estado == 'Borrador'
        );
    }

    match /facturacion/{docId} {
      allow read, create, update: if canBusinessAll();

      allow delete: if canBusinessAll()
        && (
          !('estadoSunat' in resource.data)
          || resource.data.estadoSunat != 'ACEPTADA'
        );
    }

    match /configuracion/{docId} {
      allow read: if isActiveUser()
        && (isGerente() || isAdministrador() || isSoporteTI() || isJefeProyectoMina());

      allow create, update: if isActiveUser()
        && (isGerente() || isSoporteTI());

      allow create: if isActiveUser()
        && isAdministrador()
        && request.resource.data.keys().hasOnly([
          'cotizacion',
          'ordenCompra',
          'updatedAt'
        ]);

      allow update: if isActiveUser()
        && isAdministrador()
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'cotizacion',
            'ordenCompra',
            'updatedAt'
          ]);

      allow delete: if false;
    }

    match /logs/{docId} {
      allow create: if false;

      allow read: if isActiveUser()
        && (isGerente() || isSoporteTI());

      allow update, delete: if false;
    }

    match /ruc_cache/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
